# Venice
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_AGENT_MODEL=claude-fable-5
# Part 2 (production) models
# First shot of a sequence: reference-to-video keeps the guide character consistent (5s/10s only).
VENICE_VIDEO_MODEL=wan-2-7-reference-to-video
# Follow-up shots chain from the previous last frame (5s/10s/15s).
VENICE_VIDEO_CHAIN_MODEL=wan-2-7-image-to-video
VENICE_IMAGE_MODEL=gpt-image-2
VENICE_TTS_MODEL_EN=tts-elevenlabs-turbo-v2-5
VENICE_TTS_MODEL_DE=tts-gradium-v1
VENICE_STT_MODEL=openai/whisper-large-v3

# Cortex (read-only production instance)
CORTEX_BASE_URL=
CORTEX_API_KEY=

# App
APP_LANG=de
STORAGE_PATH=./data
# Overrides the design system's single chromatic accent (any CSS color).
# Default: oklch(0.79 0.18 70.67) — the Cortex amber.
# ACCENT_COLOR=oklch(0.72 0.15 220)
