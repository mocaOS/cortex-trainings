# Venice
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_AGENT_MODEL=claude-fable-5
# Part 2 (production) models
# First shot of a sequence: reference-to-video keeps the guide character consistent (5s/10s only).
VENICE_VIDEO_MODEL=wan-2-7-reference-to-video
# Follow-up shots chain from the previous last frame (5s/10s/15s).
VENICE_VIDEO_CHAIN_MODEL=wan-2-7-image-to-video
# Shots the storyboard marks character-free, when the project has no style reference images.
# Defaults to the text-to-video sibling of VENICE_VIDEO_MODEL — keep the family, or the cut shows.
# VENICE_VIDEO_TEXT_MODEL=wan-2-7-text-to-video
VENICE_IMAGE_MODEL=gpt-image-2
# Renders the guide character FROM uploaded reference images (/image/multi-edit).
VENICE_IMAGE_EDIT_MODEL=gpt-image-2-edit
# Analyzes uploaded character/style reference images; must support vision (defaults to the agent model).
# VENICE_VISION_MODEL=claude-fable-5
VENICE_TTS_MODEL_EN=tts-elevenlabs-turbo-v2-5
VENICE_TTS_MODEL_DE=tts-gradium-v1
# Unused: timing comes from per-sentence synthesis, not transcription (see docs/venice-notes.md).
VENICE_STT_MODEL=openai/whisper-large-v3
# Tempo is applied with ffmpeg atempo — some TTS models ignore the API's `speed` parameter.
TTS_TEMPO=1.15
# The speech endpoint answers 500 under heavy concurrency; 3 is comfortable.
TTS_CONCURRENCY=3
# A whole curriculum travels inside one tool call's arguments; too low truncates it mid-JSON.
VENICE_MAX_OUTPUT_TOKENS=64000

# Cortex (read-only production instance)
CORTEX_BASE_URL=
CORTEX_API_KEY=

# App
APP_LANG=de
STORAGE_PATH=./data
# Overrides the design system's single chromatic accent (any CSS color).
# Default: oklch(0.79 0.18 70.67) — the Cortex amber.
# ACCENT_COLOR=oklch(0.72 0.15 220)
