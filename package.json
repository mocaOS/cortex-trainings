{
  "name": "cortex-trainings",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w apps/web",
    "typecheck": "npm run typecheck -ws --if-present",
    "worker": "npm run dev -w apps/worker"
  },
  "engines": {
    "node": ">=22"
  }
}
